<Window x:Class="TextEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextEditor.UI.Controls"
        xmlns:converter="clr-namespace:TextEditor.UI.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <converter:PercentageConverter x:Key="PercentageConverter" />
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Open" Click="OpenFileClick" />
            <Button Content="Save" Click="SaveFileClick" />
            <Button Content="Undo" Click="UndoClick" />
            <Button Content="Bold" Click="ApplyBoldClick" />
        </StackPanel>

        <local:RopeEditorControl x:Name="EditorControl" />
    </DockPanel>
</Window>
