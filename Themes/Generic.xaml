<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TextEditor.UI.Controls">

    <Style TargetType="{x:Type local:RopeEditorControl}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="AliceBlue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RopeEditorControl}">
                        <Border
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                            <!-- No children here, 
                                so the only "visual" from the template is a thin border outline -->
                        </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
